# Node / server
NODE_ENV="development"    # development | production
PORT=5000

# Database (MongoDB connection string)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/<db>?retryWrites=true&w=majority"

# Gemini / external API keys
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Bcrypt settings
BCRYPT_SALT_ROUNDS=12

# Email configuration (used by nodemailer)
NODE_MAILER_EMAIL="your-email@example.com"
NODE_MAILER_PASSWORD="your-email-password"

# JWT configuration
ACCESS_TOKEN_SECRET="your_access_token_secret"
ACCESS_TOKEN_EXPIRES_IN="7d"
REFRESH_TOKEN_SECRET="your_refresh_token_secret"
REFRESH_TOKEN_EXPIRES_IN="356d"

# Password reset token
RESET_PASS_TOKEN="your_reset_pass_token"
RESET_PASS_TOKEN_EXPIRES_IN="5m"

# Frontend URL
CLIENT_URL="http://localhost:5173"

# Firebase service account JSON (single-line string). Replace the value with your JSON
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your-project-id","private_key":"-----BEGIN PRIVATE KEY-----\\nYOUR_PRIVATE_KEY_HERE\\n-----END PRIVATE KEY-----\\n","client_email":"your-client-email@your-project.iam.gserviceaccount.com"}'


