        "mongoose": "^8.18.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@eslint/js": "^9.34.0",
        "@types/cookie-parser": "^1.4.9",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/node": "^24.3.0",
        "@typescript-eslint/eslint-plugin": "^8.41.0",
        "@typescript-eslint/parser": "^8.41.0",
        "eslint": "^9.34.0",
        "globals": "^16.3.0",
        "jiti": "^2.5.1",
        "prettier": "^3.6.2",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.41.0"
    }
