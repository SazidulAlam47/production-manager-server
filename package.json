    "description": "A backend server for production-manager",
    "main": "scr/server.ts",
    "scripts": {
        "build": "tsc",
        "start": "node dist/server.js",
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "lint": "eslint src/ --fix",
        "format": "prettier --ignore-path .gitignore --write \"src/**/*.+(ts|json)\"  \"*.+(mjs|json)\""
